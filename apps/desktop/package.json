{
  "name": "alexpanel-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "DominosLand Launcher: jocuri, servere live, streaming, clipuri, Game Booster si Jarvis AI.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:vite": "vite --host 127.0.0.1 --port 5178",
    "dev": "concurrently -k \"npm run dev:vite\" \"wait-on http://127.0.0.1:5178 && electron .\"",
    "build": "tsc && vite build",
    "start:web": "vite preview --host 127.0.0.1 --port 5178",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.dominosland.launcher",
    "productName": "DominosLand Launcher",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.png",
      "artifactName": "DominosLand-Launcher-Setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "resources/icon.png"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DominosLand"
    }
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^6.0.4",
    "adm-zip": "^0.6.1",
    "axios": "^1.18.1",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.27.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io-client": "^4.8.3",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "0.9.0-beta.37"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "wait-on": "^9.1.0"
  }
}
