#!/bin/sh
# Copyright (c) 2026-2027 DominosLand by Capitanul Burcea-Alex.
# Ruleaza in chroot-ul imaginii, dupa instalarea pachetelor.
set -e

# Numele sistemului. /etc/os-release e de obicei un link catre /usr/lib/os-release (pachetul base-files);
# il inlocuim cu un fisier propriu ca actualizarile Debian sa nu rescrie numele inapoi.
. /usr/lib/os-release
rm -f /etc/os-release
cat > /etc/os-release <<EOF
PRETTY_NAME="DominosLand OS"
NAME="DominosLand OS"
ID=dominosland
ID_LIKE=debian
VERSION_ID="${VERSION_ID}"
VERSION_CODENAME=${VERSION_CODENAME}
HOME_URL="https://dominosland.com"
EOF

# Romana implicit, cu engleza disponibila.
sed -i 's/^# *\(ro_RO.UTF-8\)/\1/; s/^# *\(en_US.UTF-8\)/\1/' /etc/locale.gen
locale-gen
update-locale LANG=ro_RO.UTF-8

# Sesiunea grafica inlocuieste login-ul text de pe tty1; dominosd porneste in ea (dominosland-session).
systemctl enable dominosland-shell.service

# Fisierele din includes.chroot pierd uneori bitul de executie (de ex. la o copie de pe Windows).
chmod 755 /usr/local/bin/dominosland-session /usr/lib/systemd/system-generators/dominosland-user-generator
systemctl set-default graphical.target

# Ecranul de pornire: tema DominosLand foloseste animatia temei "spinner" si logo-ul nostru.
# cp -n pastreaza watermark.png-ul DominosLand daca spinner are si el unul.
THEME=/usr/share/plymouth/themes/dominosland
cp -n /usr/share/plymouth/themes/spinner/*.png "$THEME/"
plymouth-set-default-theme dominosland
# Tema se citeste din initramfs, deci il regeneram dupa ce o schimbam.
update-initramfs -u -k all
