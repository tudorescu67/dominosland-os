# Interfata DominosLand OS pe tot ecranul, pe tty1, in locul login-ului text.
[Unit]
Description=DominosLand OS - interfata grafica
After=systemd-user-sessions.service
Conflicts=getty@tty1.service

[Service]
# Utilizatorul real e ales la pornire de dominosland-user-generator; "dominos" ramane rezerva.
User=dominos
# PAMName creeaza o sesiune logind activa: de ea depinde regula polkit pentru modul joc.
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
UtmpIdentifier=tty1
StandardInput=tty
StandardOutput=journal
Environment=XDG_SESSION_TYPE=wayland
ExecStart=/usr/bin/cage -s -- /usr/local/bin/dominosland-session
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
